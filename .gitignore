# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Uploaded assets — kept in Replit workspace but excluded from Git
# (includes capstone spec, SQL dumps, ZIP datasets, conversation prompts)
attached_assets/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.pythonlibs/
.venv/
venv/

# Environment files
.env
backend/.env
!.env.example
!backend/.env.example

# Database files and backups
*.sql
*.dump
*.tar
backend/data/*.sql
backend/data/*.dump
backend/data/ocr_uploads/
backend/data/document_storage/
backups/

# Generated temporary-credential output — scripts/seed_users.py (RC1 Phase 0
# — Security Remediation, Finding 3). Never commit generated passwords.
backend/data/*.local.txt

# Local database files
*.db
*.sqlite3
*.postgres_dump

# Logs
*.log
logs/

# Test and debug files — anchored to the repo root / backend root only
# (not `/`-anchored before Sprint 5, these unintentionally also matched
# backend/tests/test_*.py, silently gitignoring the entire real pytest
# suite from Sprints 1-4). backend/tests/ is the real test suite and must
# always be trackable — see the `!backend/tests/` rule below as a
# belt-and-suspenders guarantee against any future rule reintroducing this.
/test_*.py
/*_test.py
backend/test_*.py
backend/*_test.py
!backend/tests/
!backend/tests/test_*.py
screenshots/

# Generated API client files
# These ARE intentionally tracked in git so the build works after a fresh clone
# without requiring a `pnpm --filter @workspace/api-spec run codegen` step.
# If you change openapi.yaml, run codegen and commit the updated generated files.
# lib/api-client-react/src/generated/
# lib/api-zod/src/generated/
